<Window x:Class="Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server Monitor 관제" Height="900" Width="1320" MinWidth="1000" MinHeight="640"
        FontFamily="Pretendard, Malgun Gothic, Segoe UI" FontSize="13"
        Foreground="#FF000000" Background="#FFF1FEEC">
    <Window.Resources>
        <SolidColorBrush x:Key="MintBrush" Color="#F1FEEC"/>
        <SolidColorBrush x:Key="DustBrush" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="LilacBrush" Color="#AC92A6"/>
        <SolidColorBrush x:Key="SubBrush" Color="#525252"/>
        <SolidColorBrush x:Key="CpuBrush" Color="#E896D9"/>
        <SolidColorBrush x:Key="MemBrush" Color="#FEDBBE"/>
        <SolidColorBrush x:Key="OkBrush" Color="#99D586"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F29797"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FF7066"/>
        <SolidColorBrush x:Key="OffBrush" Color="#A5A5A5"/>
        <SolidColorBrush x:Key="OkSoftBrush" Color="#D1ECC8"/>
        <SolidColorBrush x:Key="WarnSoftBrush" Color="#F9D0D0"/>
        <SolidColorBrush x:Key="BadSoftBrush" Color="#FFCDC9"/>
        <SolidColorBrush x:Key="SelSoftBrush" Color="#F3EEF2"/>
        <SolidColorBrush x:Key="HeadBgBrush" Color="#F8FEF6"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DustBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,11,11"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DustBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="13,9"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource LilacBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource DustBrush}" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeadBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DustBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FlatCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelSoftBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DustBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FlatHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource FlatCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource FlatRow}"/>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource OffBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="정상">
                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="경고">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" Padding="10,8" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LilacBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 상단 바 -->
        <Border DockPanel.Dock="Top" Height="52" Background="White"
                BorderBrush="{StaticResource DustBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource LilacBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Server Monitor" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="장비 CPU·메모리 실시간 관제" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="14" Padding="12,5"
                        Background="{StaticResource MintBrush}" BorderBrush="{StaticResource DustBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 사이드바: 장비 목록 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource DustBrush}"
                    BorderThickness="0,0,1,0" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,2,0,10">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}"
                                   Text="{Binding Devices.Count, StringFormat={}{0}대, Mode=OneWay}"/>
                        <TextBlock Text="장비 목록" FontWeight="Bold"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SideItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Hint}"
                                               Text="{Binding Cpu, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 본문 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,12,1,1">

                    <!-- 위젯 4개 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="장비 상태 요약"/>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="13,12" Height="110">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas x:Name="DonutCanvas" Width="110" Height="110"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="정상" Foreground="{StaticResource SubBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OkCount, Mode=OneWay}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="경고 (80%↑)" Foreground="{StaticResource SubBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding WarnCount, Mode=OneWay}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource OffBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="오프라인" Foreground="{StaticResource SubBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OfflineCount, Mode=OneWay}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="%"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="CPU 사용률 Top 5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding TopCpu}" Margin="13,8" MinHeight="110">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding Value, Mode=OneWay}" Margin="6,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource PillBar}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F1}, Mode=OneWay}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="%"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="메모리 사용률 Top 5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding TopMemory}" Margin="13,8" MinHeight="110">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding Value, Mode=OneWay}" Margin="6,0"
                                                             Style="{StaticResource PillBar}" Foreground="{StaticResource MemBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F1}, Mode=OneWay}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="최근 20건 기준"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="알람 현황"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="13,12" MinHeight="110">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AlertCountText, Mode=OneWay}" FontSize="34" FontWeight="Bold"/>
                                        <TextBlock Text="건" Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LatestAlertText, Mode=OneWay}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding AlertTopText, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 선택 장비 KPI -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeader}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="최근 60초 기준"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedTitle, Mode=OneWay}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <UniformGrid Columns="4" Margin="13,12,3,12">
                                <Border Background="{StaticResource MintBrush}" BorderBrush="{StaticResource DustBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="현재 CPU" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding CurrentCpuText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MintBrush}" BorderBrush="{StaticResource DustBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="현재 메모리" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding CurrentMemoryText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MintBrush}" BorderBrush="{StaticResource DustBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU 60초 평균" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding AvgCpuText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource MintBrush}" BorderBrush="{StaticResource DustBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU 60초 최대" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding MaxCpuText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 그래프 2개 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="점선: 경고 80%"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="CPU 추이"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Canvas x:Name="CpuCanvas" Height="210" Margin="13,10" ClipToBounds="True" SizeChanged="Canvas_SizeChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="최근 60초"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="메모리 추이"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Canvas x:Name="MemCanvas" Height="210" Margin="13,10" ClipToBounds="True" SizeChanged="Canvas_SizeChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 표 2개 (세로로 쌓아 각각 전체 폭 사용) -->
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="행을 클릭하면 위 그래프가 바뀝니다"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="장비 상세"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid Style="{StaticResource FlatGrid}" MaxHeight="320"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="상태" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource DustBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="정상">
                                                                        <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="경고">
                                                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="장비" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="CPU" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                                        <ProgressBar Value="{Binding Cpu, Mode=OneWay}" Margin="0,0,8,0">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource PillBar}">
                                                                    <Setter Property="Foreground" Value="{StaticResource CpuBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="경고">
                                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                        <TextBlock Grid.Column="1" Text="{Binding Cpu, StringFormat={}{0:F1}%, Mode=OneWay}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="메모리" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                                        <ProgressBar Value="{Binding Memory, Mode=OneWay}" Margin="0,0,8,0"
                                                                     Style="{StaticResource PillBar}" Foreground="{StaticResource MemBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Memory, StringFormat={}{0:F1}%, Mode=OneWay}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="마지막 수신" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LastSeenLocal, Mode=OneWay}" Foreground="{StaticResource SubBrush}" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="최근 20건"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource LilacBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="알람 이력"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid Style="{StaticResource FlatGrid}" MaxHeight="320" ItemsSource="{Binding Alerts}"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="시각" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource SubBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="장비" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="종류" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,1" Background="{StaticResource BadSoftBrush}">
                                                        <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="값 / 기준" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ValueText, Mode=OneWay}" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
