<Window x:Class="Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server Monitor 관제" Height="780" Width="980">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="0,0,0,8" FontSize="14" Text="연결 중..."/>

        <DataGrid x:Name="DeviceGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="DeviceGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="경고">
                            <Setter Property="Background" Value="#FFFDE2E2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="오프라인">
                            <Setter Property="Background" Value="#FFE5E5E5"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="장비" Binding="{Binding DeviceName}" Width="*"/>
                <DataGridTextColumn Header="CPU (%)" Binding="{Binding Cpu, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="메모리 (%)" Binding="{Binding Memory, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="마지막 수신" Binding="{Binding LastSeenLocal}" Width="120"/>
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="GraphTitle" Grid.Row="2" Margin="0,12,0,4" FontSize="14" FontWeight="Bold"
                   Text="장비를 선택하면 그래프가 표시됩니다"/>

        <Border Grid.Row="3" BorderBrush="#FF999999" BorderThickness="1" Background="White">
            <Canvas x:Name="GraphCanvas" ClipToBounds="True" SizeChanged="GraphCanvas_SizeChanged"/>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,12,0,4" FontSize="14" FontWeight="Bold" Text="최근 알람"/>

        <DataGrid x:Name="AlertGrid" Grid.Row="5" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="120"/>
                <DataGridTextColumn Header="장비" Binding="{Binding DeviceName}" Width="*"/>
                <DataGridTextColumn Header="종류" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="값 (%)" Binding="{Binding Value, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="기준 (%)" Binding="{Binding Threshold, StringFormat=F0}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
