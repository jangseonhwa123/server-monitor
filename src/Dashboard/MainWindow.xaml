<Window x:Class="Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseMon 관제" Height="960" Width="1500" MinWidth="1000" MinHeight="640"
        FontFamily="Pretendard, Malgun Gothic, Segoe UI" FontSize="16"
        Foreground="#FFEAF2FF" Background="#FF000000">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#00D4FF"/>
        <SolidColorBrush x:Key="Line2Brush" Color="#3A5BFF"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#6EF2A0"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#E8D82A"/>
        <SolidColorBrush x:Key="KpiBrush" Color="#A9B77A"/>
        <SolidColorBrush x:Key="SubBrush" Color="#9FB0D0"/>
        <SolidColorBrush x:Key="GridBrush" Color="#1B2747"/>
        <SolidColorBrush x:Key="RowLineBrush" Color="#101A33"/>
        <SolidColorBrush x:Key="CpuBrush" Color="#B26BFF"/>
        <SolidColorBrush x:Key="MemBrush" Color="#FFB066"/>
        <SolidColorBrush x:Key="RingBrush" Color="#6C4CFF"/>
        <SolidColorBrush x:Key="OkBrush" Color="#5CFF9D"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FF5C7A"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FF5C7A"/>
        <SolidColorBrush x:Key="OffBrush" Color="#7A7F8C"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#0D0D14"/>
        <SolidColorBrush x:Key="TrackLineBrush" Color="#AAB4D8"/>
        <SolidColorBrush x:Key="SelSoftBrush" Color="#06101F"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#0B1530"/>
        <SolidColorBrush x:Key="BadSoftBrush" Color="#33FF5C7A"/>
        <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4FA3FF" Offset="0"/>
            <GradientStop Color="#A56CFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- 네온 카드 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#00D4FF"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,10,16,8"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource CpuBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource TrackBrush}"
                                    BorderBrush="{StaticResource TrackLineBrush}" BorderThickness="1" CornerRadius="6"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="1"
                                    Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FlatCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFEAF2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#FFEAF2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelSoftBrush}"/>
                    <Setter Property="Foreground" Value="#FFEAF2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#FFEAF2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RowLineBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FlatHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource FlatCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource FlatRow}"/>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{StaticResource OffBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="정상">
                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="경고">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" Padding="8,7" Margin="0,0,0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5500D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 별 모양 장식 -->
        <Style x:Key="Spark" TargetType="Path">
            <Setter Property="Data" Value="M50,0 L56,44 L100,50 L56,56 L50,100 L44,56 L0,50 L44,44 Z"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="1" Color="#4FA3FF"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- 상단 바 -->
            <Border DockPanel.Dock="Top" Height="72" Background="Black"
                    BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,2">
                <Grid Margin="24,0,78,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="44" Height="44" Margin="0,0,10,0">
                            <Ellipse Width="30" Height="30" Fill="#0B0F2A" Stroke="{StaticResource LogoBrush}" StrokeThickness="2.5"/>
                            <Ellipse Width="44" Height="14" Stroke="{StaticResource LogoBrush}" StrokeThickness="2">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-25" CenterX="22" CenterY="7"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Polyline Stroke="#6EF2FF" StrokeThickness="2.2" StrokeLineJoin="Round"
                                      Points="8,23 16,23 19,14 24,31 28,20 31,23 36,23"/>
                        </Grid>
                        <TextBlock Text="PulseMon" FontSize="30" FontWeight="ExtraBold" FontStyle="Italic"
                                   Foreground="{StaticResource LogoBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Padding="14,5"
                            Background="Black" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="15" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 사이드바: 장비 목록 -->
                <Border Grid.Column="0" Background="Black" BorderBrush="{StaticResource Line2Brush}"
                        BorderThickness="0,0,2,0" Padding="20,16">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Bottom"
                                       Text="{Binding Devices.Count, StringFormat={}{0}대, Mode=OneWay}"/>
                            <TextBlock Text="장비 목록" FontSize="28" Foreground="{StaticResource YellowBrush}"/>
                        </DockPanel>

                        <!-- 검색 -->
                        <Border DockPanel.Dock="Top" CornerRadius="20" BorderThickness="2" Margin="0,0,0,18" Padding="12,5"
                                BorderBrush="{StaticResource LineBrush}" Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" Color="#00D4FF"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="검색" FontSize="17" HorizontalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="17"
                                         Foreground="#FFEAF2FF" CaretBrush="#FFEAF2FF" TextAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" Foreground="#FFEAF2FF"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource SideItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse HorizontalAlignment="Left">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="★" FontSize="20" Foreground="{StaticResource LineBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="19"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" FontSize="19"
                                                   Text="{Binding Cpu, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 본문 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20,6,4">

                        <!-- 위젯 3개 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="장비 상태 요약"/>
                                    </Border>
                                    <Grid Margin="16,12" Height="140">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Canvas x:Name="DonutCanvas" Width="140" Height="140"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource RingBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="정상" Foreground="{StaticResource SubBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding OkCount, Mode=OneWay}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource WarnBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="경고 (80%↑)" Foreground="{StaticResource SubBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WarnCount, Mode=OneWay}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="{StaticResource OffBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="오프라인" Foreground="{StaticResource SubBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding OfflineCount, Mode=OneWay}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </Grid>
                                            <Border BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="알람 (최근 20건)" Foreground="{StaticResource SubBrush}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AlertCountText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="건" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="CPU 사용률 Top 5"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TopCpu}" Margin="16,8" MinHeight="150">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="1" Value="{Binding Value, Mode=OneWay}" Margin="8,0">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource PillBar}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F1}, Mode=OneWay}" FontSize="15" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="메모리 사용률 Top 5"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TopMemory}" Margin="16,8" MinHeight="150">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="1" Value="{Binding Value, Mode=OneWay}" Margin="8,0"
                                                                 Style="{StaticResource PillBar}" Foreground="{StaticResource MemBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F1}, Mode=OneWay}" FontSize="15" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 선택 장비 KPI -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <Grid>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedTitle, Mode=OneWay}"/>
                                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" Text="최근 60초 기준"/>
                                    </Grid>
                                </Border>
                                <UniformGrid Columns="3" Margin="16,16,0,18">
                                    <Border Background="Black" BorderBrush="{StaticResource KpiBrush}" BorderThickness="2" CornerRadius="22" Padding="12,14" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock Text="현재 CPU" FontSize="17" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentCpuText, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#FFEDEDED" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="Black" BorderBrush="{StaticResource KpiBrush}" BorderThickness="2" CornerRadius="22" Padding="12,14" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock Text="현재 메모리" FontSize="17" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentMemoryText, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#FFEDEDED" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="Black" BorderBrush="{StaticResource KpiBrush}" BorderThickness="2" CornerRadius="22" Padding="12,14" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock Text="CPU 60초 평균" FontSize="17" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding AvgCpuText, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#FFEDEDED" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 그래프 2개 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="CPU 추이"/>
                                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" Text="점선: 경고 80%"/>
                                        </Grid>
                                    </Border>
                                    <Canvas x:Name="CpuCanvas" Height="230" Margin="14,10" ClipToBounds="True" SizeChanged="Canvas_SizeChanged"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border Style="{StaticResource CardHeader}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="메모리 추이"/>
                                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" Text="최근 60초"/>
                                        </Grid>
                                    </Border>
                                    <Canvas x:Name="MemCanvas" Height="230" Margin="14,10" ClipToBounds="True" SizeChanged="Canvas_SizeChanged"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 알람 이력 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Style="{StaticResource CardHeader}">
                                    <Grid>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="알람 이력"/>
                                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" Text="최근 20건"/>
                                    </Grid>
                                </Border>
                                <DataGrid Style="{StaticResource FlatGrid}" MaxHeight="300" ItemsSource="{Binding Alerts}"
                                          SelectionMode="Single" Margin="4,2,4,10">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="시각" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource SubBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="장비" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="종류" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="9,1"
                                                            Background="{StaticResource BadSoftBrush}"
                                                            BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Type}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFD0D8"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="값 / 기준" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ValueText, Mode=OneWay}" HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- 반짝이 장식 -->
        <Path Style="{StaticResource Spark}" Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,42,0,0"/>
        <Path Style="{StaticResource Spark}" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,6,0"/>
        <Path Style="{StaticResource Spark}" Width="54" Height="54" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="273,0,0,20"/>
    </Grid>
</Window>
